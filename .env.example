// ─────────────────────────────────────────────────────────────
// .env  —  EcoNova Pilot Environment Variables
// Copy this file to .env and fill in your Supabase credentials.
// NEVER commit the filled .env to git.
// ─────────────────────────────────────────────────────────────

# Supabase project URL — found in: Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key — safe to embed in client apps (RLS enforces access)
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
